# Copy to .env (which is git-ignored) and edit. Read by compose.yaml.

# The Postgres password for the stack's own database. Any long random string.
POSTGRES_PASSWORD=change-me

# Where the app is served on this machine: http://127.0.0.1:${WEB_PORT}
WEB_PORT=8080

# How long finished results are kept before they are deleted (hours).
DENT_RESULT_TTL_HOURS=72
# Largest accepted upload (MB).
DENT_UPLOAD_MAX_MB=1024

# The GPU. "off" = this worker has the GPU to itself (the default for a self-hosted
# box). To share the GPU with other services that take the same Postgres advisory
# lock, set GPU_LOCK_DSN to that database and DENT_GPU_LOCK=required.
DENT_GPU_LOCK=off
GPU_LOCK_DSN=

# Leave empty to run without the optional ToothSeg teeth specialist.
DENT_TF3_TOOTHSEG_DIR=toothseg_semantic
