# worker/ and scripts/ are IN the context: Dockerfile.worker copies them. They are small,
# and the API and web images copy only the directories they name.
venv/
venv-umamba/
__pycache__/
*.pyc
data/
models/
eval/
tests/
training/
vendor/
k8s/
node_modules/
.worker.env
*.log

# NESTED node_modules. A bare `node_modules/` matches the top level only -- Docker's
# ignore patterns are path patterns, not "anywhere" globs -- so `viewer/node_modules`
# (94 MB) and `web-auth/node_modules` (12 MB) were both being packed into the build
# context on every build, along with `viewer/dist` (4 MB) and the git history.
**/node_modules/
viewer/dist/
viewer/reference/
.git/
.github/
web-auth/

# Landing tooling is used only in its build stage; only dist is served by nginx.
landing/dist/
landing/.astro/
landing/.generated-public/
landing/artifacts/

# Marketing films and raw captures (615 MB) are never part of an image; the landing's
# web renditions live under landing/assets/media/.
marketing/
landing/.media-work/
