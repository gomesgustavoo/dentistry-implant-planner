venv/
venv-umamba/
__pycache__/
*.pyc
data/
models/
eval/
tests/
scripts/
worker/
training/
vendor/
k8s/
node_modules/
.worker.env
*.log

# NESTED node_modules. A bare `node_modules/` matches the top level only -- Docker's
# ignore patterns are path patterns, not "anywhere" globs -- so `viewer/node_modules`
# (94 MB) and `web-auth/node_modules` (12 MB) were both being packed into the build
# context on every build, along with `viewer/dist` (4 MB) and the git history.
**/node_modules/
viewer/dist/
viewer/reference/
.git/
.github/
web-auth/

# Dockerfile.landing does `COPY landing/ /usr/share/nginx/html/`, so ANY file left in that
# tree is served publicly. The landing's own tooling lives in scripts/ (already excluded
# above) precisely for that reason; these two patterns are the guard for the next person
# who reaches for the obvious place to put a build script.
landing/*.mjs
landing/*.py
landing/*.sh
