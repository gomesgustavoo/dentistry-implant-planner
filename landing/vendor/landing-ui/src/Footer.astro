---
import type { Project } from './types';
interface Props { project: Project }
const { project: p } = Astro.props;
---
<footer class="footer container">
  <div class="footer__top"><a class="brand" href="/">{p.wordmark[0]}<span>{p.wordmark[1]}</span></a><a href={p.sibling.href}>Also by Gustavo: {p.sibling.label} <span aria-hidden="true">↗</span></a><a href="#top">Back to top ↑</a></div>
  <div class="footer__bottom"><p>© {new Date().getFullYear()} Gustavo Formento · Research and educational use only. Not a medical device.</p><nav aria-label="Legal"><a href="/privacy.html">Privacy</a><a href="/terms.html">Terms</a><a href="mailto:support@dicomsegvr.com">Support</a></nav></div>
  {p.id === 'implantplan' && <p class="license">Segmentation model derived from ToothFairy3 · <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" rel="license">CC BY-NC-SA 4.0</a> · Non-commercial research use.</p>}
</footer>
