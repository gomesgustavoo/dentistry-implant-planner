---
import type { Project } from './types';
import Base from './Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { localePath, t } from './i18n';
interface Props { project: Project; content: string }
const { project: p, content } = Astro.props;
const s = t(p.locale).engineering;
const [line1, line2] = s.heading(p.name);
---
<Base project={p} path="/engineering/" title={s.title(p.name)} description={p.engineeringIntro}>
  <Nav project={p} path="/engineering/" />
  <main id="main" class="engineering-page container">
    <header class="engineering-head"><a class="text-link" href={localePath(p.locale, '/')}>{s.back(p.name)}</a><p class="eyebrow">{s.eyebrow}</p><h1>{line1}<br /><span>{line2}</span></h1><p>{p.engineeringIntro}</p><div class="creator__links">{p.repo && <a class="button" href={p.repo}>{s.source} ↗</a>}<a class:list={[p.repo ? 'text-link' : 'button']} href={p.primary.href}>{s.app} ↗</a></div></header>
    <div class="research" set:html={content} />
    <div class="section-end"><a class="text-link" href={localePath(p.locale, '/')}>{s.backProject}</a><a class="text-link" href="https://www.linkedin.com/in/gustavoogomesss/">{s.discuss} ↗</a></div>
  </main>
  <Footer project={p} />
</Base>
