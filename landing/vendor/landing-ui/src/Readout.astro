---
import type { Locale } from './types';
import { LOCALE_META, decimal, t } from './i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const h = t(locale).hero3d;
const fill = (tpl: string, v: Record<string, string>) => tpl.replace(/\{(\w+)\}/g, (_, k) => v[k] ?? '');
// The static text is the crest state, so a page without WebGL still reads correctly.
const sub = fill(h.sub, { measured: decimal(locale, 3.43), p95: decimal(locale, 0.46), graded: decimal(locale, 2.97), margin: decimal(locale, 2) });
const strings = JSON.stringify({ ...h, locale: LOCALE_META[locale].html }).replace(/</g, '\\u003c');
---
<div class="readout-area">
  <div class="hero__live readout" data-hero-readout data-level="clear">
    <div class="readout__row"><span class="readout__chip" data-hero-level>{h.clear}</span><span>{h.readoutLabel}</span></div>
    <p class="readout__value"><span data-hero-mm>{decimal(locale, 3.43)}</span><span class="readout__unit">mm</span></p>
    <p class="readout__sub" data-hero-sub>{sub}</p>
    <p class="readout__depth" data-hero-depth-line>{fill(h.depth, { depth: decimal(locale, 0, 1) })}</p>
  </div>
  <p class="visually-hidden" data-hero-live aria-live="polite"></p>
  <div class="hero__fallback readout" data-level="clear">
    <div class="readout__row"><span class="readout__chip">{h.clear}</span><span>{h.fallbackLabel}</span></div>
    <p class="readout__value">{decimal(locale, 3.51)}<span class="readout__unit">mm</span></p>
    <p class="readout__sub">{h.fallback}</p>
  </div>
  <script type="application/json" id="hero-strings" set:html={strings} />
</div>
