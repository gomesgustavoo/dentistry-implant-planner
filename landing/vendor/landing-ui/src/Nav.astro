---
import type { Project } from './types';
import { LOCALES, LOCALE_META, localePath, t } from './i18n';
interface Props { project: Project; path?: string }
const { project: p, path = '/' } = Astro.props;
const s = t(p.locale);
const onHome = path === '/';
const home = onHome ? '' : localePath(p.locale, '/');
const engineering = path === '/engineering/';
---
<header class="nav" id="top">
  <div class="container nav__inner">
    <a class="brand" href={onHome ? '#top' : localePath(p.locale, '/')} aria-label={s.nav.home(p.name)}>{p.wordmark[0]}<span>{p.wordmark[1]}</span></a>
    <span class="nav__divider" aria-hidden="true"></span><span class="nav__annotation">{s.nav.annotation}</span>
    <button class="nav__toggle" id="navToggle" aria-expanded="false" aria-controls="navMenu" aria-label={s.nav.open}><span></span><span></span></button>
    <nav class="nav__menu" id="navMenu" aria-label={s.nav.primary}>
      <a href={`${home}#demo`}>{s.nav.project}</a>
      <a href={localePath(p.locale, '/engineering/')} aria-current={engineering ? 'page' : undefined}>{s.nav.engineering}</a>
      <a href={`${home}#pricing`}>{s.nav.pricing}</a>
      <a href={`${home}#creator`}>{s.nav.creator}</a>
      <span class="lang" role="group" aria-label={s.nav.language}>{LOCALES.map(l => <a href={localePath(l, path)} hreflang={LOCALE_META[l].html} lang={LOCALE_META[l].html} title={LOCALE_META[l].name} aria-current={l === p.locale ? 'true' : undefined}>{LOCALE_META[l].short}</a>)}</span>
      <a class="button button--small" href={p.primary.href}>{s.nav.app} <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<div class="nav__scrim" id="navScrim" hidden></div>
