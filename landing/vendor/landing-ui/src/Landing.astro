---
import type { Project } from './types';
import Base from './Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Media from './Media.astro';
import Footer from './Footer.astro';
import { localePath, t } from './i18n';
interface Props { project: Project }
const { project: p } = Astro.props;
const s = t(p.locale).landing;
const v = p.demo.video;
---
<Base project={p}>
  <Nav project={p} />
  <main id="main">
    <Hero project={p} />
    <section class="section section--demo" id="demo">
      <div class="container">
        <div class="section-head" data-reveal><p class="eyebrow">{s.practice}</p><div><h2>{p.demo.title}</h2><p>{p.demo.description}</p></div></div>
        {v ? <figure class="app-demo" data-reveal><div class="app-demo__bar"><span class="status-dot"></span><span>{v.bar}</span><span>{v.badge}</span></div><video controls playsinline preload="none" poster={v.poster} aria-label={v.label}><source src={v.src} type="video/mp4" /><a href={v.src}>{s.watch}</a></video><figcaption>{v.caption}</figcaption></figure> : <Media media={p.media} locale={p.locale} />}
        <div class="steps" id="how-it-works">{p.demo.steps.map((step, i) => <article data-reveal><span class="step-index">0{i + 1}</span><h3>{step.title}</h3><p>{step.description}</p></article>)}</div>
        {p.getApp && <div class="section-end"><p>{s.headset}</p><a class="text-link" href={localePath(p.locale, p.getApp.href)}>{p.getApp.label} ↗</a></div>}
      </div>
    </section>
    <section class="section section--tinted" id="engineering">
      <div class="container">
        <span class="anchor-alias" id="problem"></span><span class="anchor-alias" id="engine"></span><span class="anchor-alias" id="serving"></span><span class="anchor-alias" id="budget"></span><span class="anchor-alias" id="planning"></span><span class="anchor-alias" id="depths"></span><span class="anchor-alias" id="arch"></span>
        <div class="section-head" data-reveal><p class="eyebrow">{s.behind}</p><div><h2>{s.systemTitle[0]}<br /><span class="muted">{s.systemTitle[1]}</span></h2><p>{s.systemText}</p></div></div>
        <div class="highlight-grid">{p.highlights.map((h, i) => <article class="highlight" data-reveal><div class="highlight__top"><span class="mono">{h.category}</span><span class="highlight__number">0{i + 1}</span></div><h3>{h.title}</h3><p>{h.description}</p><ul class="tags" aria-label={s.technologies}>{h.technologies.map(tech => <li>{tech}</li>)}</ul></article>)}</div>
        <div class="section-end"><p>{s.notesLead}</p><a class="text-link" href={localePath(p.locale, '/engineering/')}>{s.notes} <span aria-hidden="true">↗</span></a>{p.repo && <a class="text-link" href={p.repo}>{s.source} ↗</a>}</div>
      </div>
    </section>
    <section class="section" id="pricing">
      <div class="container">
        <div class="section-head" data-reveal><p class="eyebrow">{s.tryIt}</p><div><h2>{s.tryTitle}</h2><p>{p.trial} {s.usd}</p></div></div>
        <div class="plans">{p.plans.map((plan, i) => <article class:list={['plan', { 'plan--accent': i === 0 }]} data-reveal><div class="plan__top"><h3>{plan.name}</h3>{i === 0 && <span class="plan__badge">{s.start}</span>}</div><p class="plan__price">${plan.price}<span>{s.month}</span></p><p class="plan__allowance">{plan.allowance}</p><ul>{plan.features.map(f => <li>{f}</li>)}</ul><a class:list={['button', 'button--full', { 'button--secondary': i !== 0 }]} href={plan.action.href}>{plan.action.label}<span aria-hidden="true">↗</span></a><p class="plan__note">{plan.note}</p></article>)}</div>
        <p class="pricing-note">{p.pricingNote}</p>
      </div>
    </section>
    <section class="section section--faq" id="faq"><div class="container faq-layout"><div data-reveal><p class="eyebrow">{s.questions}</p><h2>{s.questionsTitle[0]}<br />{s.questionsTitle[1]}</h2><a class="text-link" href={localePath(p.locale, '/engineering/')}>{s.deeper} ↗</a></div><div class="faq">{p.faq.map(f => <details><summary>{f.question}<span aria-hidden="true">+</span></summary><p set:html={f.answer} /></details>)}</div></div></section>
    <section class="section section--tinted" id="creator"><div class="container"><div class="creator" data-reveal><div><p class="eyebrow">{s.person}</p><h2>{s.builtBy[0]}<br />{s.builtBy[1]}</h2></div><div><p class="creator__intro">{s.intro}</p><p>{p.creatorBio}</p><div class="creator__links"><a class="button" href="https://www.linkedin.com/in/gustavoogomesss/">{s.linkedin} ↗</a><a class="text-link" href="https://github.com/gomesgustavoo">{s.github} ↗</a></div></div></div>{p.related && <div class="related-media"><div><p class="eyebrow">{p.related.eyebrow}</p><h3>{p.related.title[0]}<br />{p.related.title[1]}</h3><p>{p.related.text}</p><a class="text-link" href={p.sibling.href}>{s.explore(p.sibling.label)} ↗</a></div><Media media={p.media} locale={p.locale} compact /></div>}</div></section>
  </main>
  <Footer project={p} />
</Base>
