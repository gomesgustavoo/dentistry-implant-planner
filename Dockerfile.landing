# The public marketing site. Separate image from `web` because it has its own
# nginx.conf (the .glb mime type and three cache tiers) and runs unprivileged.
#
# Recovered 2026-09-01 from `docker history dentistry/landing:0.10.0`.
FROM node:22-alpine AS build
WORKDIR /site
COPY landing/package.json landing/package-lock.json ./
COPY landing/vendor/ ./vendor/
RUN npm ci
# landing/download/ comes in with this COPY (it is gitignored, not dockerignored): that is
# how a dropped ImplantPlan VR APK reaches the build. No APK is a valid, deployable state.
COPY landing/ ./
# verify-dist runs here because the runtime stage has no node. It fails the image when a
# URL in the HTML is missing from dist, a hashed name does not match its bytes, or the APK
# in dist is not the one the /vr/ page describes (see the script's header).
RUN npm run build && node scripts/verify-dist.mjs

FROM nginx:1.27.5-alpine

COPY docker/landing-nginx.conf /etc/nginx/nginx.conf
COPY --from=build /site/dist/ /usr/share/nginx/html/

# nginx runs as uid 101, so its cache directory -- which also holds the pid file,
# see the comment in landing-nginx.conf -- has to be writable by it.
RUN chown -R 101:101 /var/cache/nginx

EXPOSE 8080
USER 101
CMD ["nginx", "-g", "daemon off;"]
