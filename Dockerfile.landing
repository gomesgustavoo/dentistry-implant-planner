# The public marketing site. Separate image from `web` because it has its own
# nginx.conf (the .glb mime type and three cache tiers) and runs unprivileged.
#
# Recovered 2026-09-01 from `docker history dentistry/landing:0.10.0`.
FROM nginx:1.27.5-alpine

COPY docker/landing-nginx.conf /etc/nginx/nginx.conf
COPY landing/ /usr/share/nginx/html/

# nginx runs as uid 101, so its cache directory -- which also holds the pid file,
# see the comment in landing-nginx.conf -- has to be writable by it.
RUN chown -R 101:101 /var/cache/nginx

EXPOSE 8080
USER 101
CMD ["nginx", "-g", "daemon off;"]
