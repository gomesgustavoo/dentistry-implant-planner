# The single-page app: nginx serving web/ as static files.
#
# Recovered 2026-09-01 from `docker history dentistry/web:0.10.0` after the project
# tree was destroyed. The base tag, the two COPYs, the cache-busting sed and its
# grep verification are all reproduced from that image's own layer commands.
#
# There is no build step, which is why web/viewer.js and web/auth.js are committed
# as built bundles rather than compiled here.
FROM nginx:1.27.5-alpine

ARG VERSION=dev

COPY web/ /usr/share/nginx/html/
COPY docker/web-default.conf /etc/nginx/conf.d/default.conf

# index.html references its assets as `app.css?v=dev`; the tag is rewritten at build
# time so a redeploy cannot leave a browser holding last version's JS. The grep is
# the point: a silent no-op sed would ship a cache-busting scheme that busts nothing.
RUN sed -i "s/?v=dev/?v=${VERSION}/g" /usr/share/nginx/html/index.html \
    && grep -q "app.css?v=${VERSION}" /usr/share/nginx/html/index.html
